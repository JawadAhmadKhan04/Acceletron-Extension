{
  "name": "acceletron-extension",
  "displayName": "Acceletron",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:cudaConverterPanel",
    "onView:chatbotPanel"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "acceletron-chatbot",
          "title": "Chatbot",
          "icon": "media/chatbot-icon.svg"
        }
      ]
    },
    "views": {
      "acceletron-chatbot": [
        {
          "id": "chatbotPanel",
          "name": "Chatbot",
          "type": "webview"
        }
      ],
      "sidebar": [
        {
          "id": "cudaConverterPanel",
          "name": "CUDA Converter",
          "icon": "$(extension)",
          "contextualTitle": "CUDA Converter Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "acceletron-extension.openCudaConverter",
        "title": "Open CUDA Converter"
      },
      {
        "command": "acceletron-extension.openChatbot",
        "title": "Open Acceletron Chatbot"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "ws": "^8.15.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.120.0",
    "@types/ws": "^8.5.10",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
